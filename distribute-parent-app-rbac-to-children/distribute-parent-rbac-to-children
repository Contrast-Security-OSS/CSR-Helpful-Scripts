def getApplications(session, headers, params, org_id, offset=0, limit=100):
    """Fetch one page of applications. Pagination via offset/limit query params."""
    paged_params = dict(params) if params else {}
    paged_params["offset"] = offset
    paged_params["limit"] = limit
    url = f"{contrast_url}/api/ng/{org_id}/applications"
    response = session.get(url, headers=headers, params=paged_params, timeout=HTTP_TIMEOUT)
    return response

def getAllApplications(session, headers, params, org_id, limit=100):
    """Iterate the applications endpoint with offset/limit pagination and return the merged list."""
    all_apps = []
    offset = 0
    while True:
        resp = getApplications(session, headers, params, org_id, offset=offset, limit=limit)
        if resp.status_code != 200:
            return resp, all_apps
        body = resp.json()
        page = body.get("applications", []) or []
        all_apps.extend(page)
        if len(page) < limit:
            break
        offset += limit
    return resp, all_apps

def getResourceGroups(session, headers, params, org_id):
    """Get all resource groups in the organization"""
    url = f"{contrast_url}/api/v4/access/organizations/{org_id}/resource-groups"
    response = session.get(url, headers=headers, params=params, timeout=HTTP_TIMEOUT)
    return response

def getResourceGroup(session, headers, params, org_id, group_id):
    """Get details for a specific resource group"""
    url = f"{contrast_url}/api/v4/access/organizations/{org_id}/resource-group/{group_id}"
    response = session.get(url, headers=headers, params=params, timeout=HTTP_TIMEOUT)
    return response

